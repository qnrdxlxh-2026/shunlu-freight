/* 登录页样式 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* Logo区域 */
.logo-section {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo-icon {
  font-size: 120rpx;
  line-height: 1;
}
.logo-title {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
  margin-top: 16rpx;
}
.logo-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 表单区域 */
.form-section {
  width: 100%;
  margin-top: 80rpx;
}
.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}
.input-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.input-item.no-border {
  border-bottom: none;
}
.input-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.input-item input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 44rpx;
}

/* 登录按钮 */
.login-btn {
  margin-top: 40rpx;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 34rpx;
  box-shadow: 0 8rpx 24rpx rgba(82, 196, 26, 0.4);
}
.btn-disabled {
  background-color: #b8e6a3 !important;
  color: #fff !important;
  box-shadow: none !important;
}

/* 注册入口 */
.register-entry {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40rpx;
}
.link {
  color: #fff;
  font-size: 28rpx;
  margin-left: 8rpx;
  text-decoration: underline;
}
