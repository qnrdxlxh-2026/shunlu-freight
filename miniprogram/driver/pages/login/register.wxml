<view class="container">
  <view class="logo-section">
    <text class="app-name">顺路货运</text>
    <text class="slogan">司机端</text>
  </view>
  <view class="form-section">
    <view class="form-item">
      <text class="label">手机号</text>
      <input type="number" maxlength="11" placeholder="请输入手机号" bindinput="onPhoneInput" value="{{phone}}" />
    </view>
    <view class="form-item">
      <text class="label">密码</text>
      <input password placeholder="请输入密码" bindinput="onPwdInput" value="{{password}}" />
    </view>
    <view class="form-item">
      <text class="label">确认密码</text>
      <input password placeholder="请再次输入密码" bindinput="onPwd2Input" value="{{password2}}" />
    </view>
    <view class="form-item">
      <text class="label">车辆类型</text>
      <picker bindchange="onTypeChange" value="{{driverTypeIndex}}" range="{{driverTypes}}">
        <view class="picker">{{driverTypes[driverTypeIndex]}}</view>
      </picker>
    </view>
  </view>
  <view class="btn-area">
    <button class="btn-primary" bindtap="onRegister" disabled="{{loading}}">
      <text wx:if="{{!loading}}">注册并登录</text>
      <text wx:if="{{loading}}">注册中...</text>
    </button>
    <view class="links"><text class="link" bindtap="goLogin">已有账号？立即登录</text></view>
  </view>
</view>
