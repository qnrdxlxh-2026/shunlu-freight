.routes-page{padding:24rpx;background:#f5f5f5;min-height:100vh;padding-bottom:120rpx}
.route-item{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}
.route-header{display:flex;align-items:center;margin-bottom:16rpx}
.route-from,.route-to{font-size:30rpx;color:#333;font-weight:500}
.route-arrow{color:#52c41a;margin:0 16rpx;font-size:28rpx}
.route-info{display:flex;justify-content:space-between;font-size:26rpx;color:#666}
.route-status{font-size:24rpx;color:#52c41a;margin-top:12rpx}
.empty{text-align:center;padding:100rpx 0;color:#999}
.loading{text-align:center;padding:100rpx 0;color:#999}
.fab{position:fixed;right:32rpx;bottom:120rpx;width:112rpx;height:112rpx;background:#52c41a;color:#fff;border-radius:50%;font-size:48rpx;display:flex;align-items:center;justify-content:center;box-shadow:0 4rpx 16rpx rgba(82,196,26,0.4);padding:0;line-height:112rpx;text-align:center}
