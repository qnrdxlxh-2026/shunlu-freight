/* 注册页样式 */
.register-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.form-section {
  padding: 40rpx 30rpx;
}

.input-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.input-row {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.input-row.no-border {
  border-bottom: none;
}
.input-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.input-row input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

/* 司机类型选择 */
.type-section {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.type-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
  font-weight: 500;
}
.type-grid {
  display: flex;
  gap: 20rpx;
}
.type-card {
  flex: 1;
  background: #fafafa;
  border: 2rpx solid #f0f0f0;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  transition: all 0.2s;
}
.type-card.active {
  border-color: #52c41a;
  background: #f6ffed;
}
.type-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}
.type-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}
.type-desc {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}
.type-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 36rpx;
  height: 36rpx;
  background: #52c41a;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
}

/* 私家车限制提示 */
.limit-tip {
  margin-top: 20rpx;
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #ad8b00;
  display: flex;
  align-items: flex-start;
}
.tip-icon {
  margin-right: 8rpx;
  flex-shrink: 0;
}

/* 注册按钮 */
.register-btn {
  margin-top: 40rpx;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 34rpx;
  box-shadow: 0 8rpx 24rpx rgba(82, 196, 26, 0.3);
}

/* 登录入口 */
.login-entry {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40rpx;
}
.link {
  color: #52c41a;
  font-size: 28rpx;
  margin-left: 8rpx;
}
