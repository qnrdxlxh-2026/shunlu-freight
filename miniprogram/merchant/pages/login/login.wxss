/* 登录页样式 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1890ff 0%, #40a9ff 100%);
  padding: 0 64rpx;
  display: flex;
  flex-direction: column;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  padding-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.form-section {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
}

.form-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.btn-login {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 48rpx;
  margin-top: 48rpx;
  border: none;
}

.btn-login::after {
  border: none;
}

.btn-login:active {
  opacity: 0.85;
}

.register-link {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #999;
}

.register-link .link {
  color: #1890ff;
  margin-left: 8rpx;
}