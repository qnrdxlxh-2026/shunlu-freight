<view class="profile-page">
  <!-- 用户卡片 -->
  <view class="user-card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view class="avatar-edit-badge">✏️</view>
    </button>
    <view class="user-detail">
      <view class="user-name-row">
        <input class="name-edit-input" value="{{userInfo.phone}}" disabled />
        <text class="edit-icon" bindtap="editName">✏️</text>
      </view>
      <view class="user-sub">已认证 · 顺路货运商家端</view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats-row">
    <view class="stat-item">
      <input class="stat-num-input" value="{{orderCount || 0}}" disabled />
      <text class="stat-label">订单</text>
    </view>
    <view class="stat-div"></view>
    <view class="stat-item">
      <text class="stat-num">¥{{balance || '0.00'}}</text>
      <text class="stat-label">余额</text>
    </view>
    <view class="stat-div"></view>
    <view class="stat-item">
      <input class="stat-num-input" value="{{goodsCount || 0}}" disabled />
      <text class="stat-label">货源</text>
    </view>
  </view>

  <!-- 核心功能（分组标题可编辑） -->
  <view class="menu-section">
    <view class="menu-title-row">
      <text class="menu-title-label">{{sectionTitles.merchantService || '📦 货运管理'}}</text>
      <text class="edit-icon sm" bindtap="editMenuTitle" data-type="merchantService">✏️</text>
    </view>
    <view class="menu-item" bindtap="goPublish">
      <view class="menu-icon-wrap orange">🚚</view>
      <view class="menu-text-wrap">
        <input class="menu-text-input" value="{{menuNames.publish}}" bindblur="saveMenuName" data-key="publish" />
      </view>
      <text class="menu-hint">一键发布</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMyGoods">
      <view class="menu-icon-wrap blue">📋</view>
      <view class="menu-text-wrap">
        <input class="menu-text-input" value="{{menuNames.myGoods}}" bindblur="saveMenuName" data-key="myGoods" />
      </view>
      <text class="menu-hint">管理货物</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goOrders">
      <view class="menu-icon-wrap green">📜</view>
      <view class="menu-text-wrap">
        <input class="menu-text-input" value="{{menuNames.allOrders}}" bindblur="saveMenuName" data-key="allOrders" />
      </view>
      <text class="menu-hint">订单记录</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goWallet">
      <view class="menu-icon-wrap gold">💰</view>
      <view class="menu-text-wrap">
        <input class="menu-text-input" value="{{menuNames.myWallet}}" bindblur="saveMenuName" data-key="myWallet" />
      </view>
      <text class="menu-hint">资金流水</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 账户（分组标题可编辑） -->
  <view class="menu-section">
    <view class="menu-title-row">
      <text class="menu-title-label">{{sectionTitles.account || '🔐 账户与安全'}}</text>
      <text class="edit-icon sm" bindtap="editMenuTitle" data-type="account">✏️</text>
    </view>
    <view class="menu-item" bindtap="goAuth">
      <view class="menu-icon-wrap teal">🪪</view>
      <view class="menu-text-wrap">
        <input class="menu-text-input" value="{{menuNames.auth}}" bindblur="saveMenuName" data-key="auth" />
      </view>
      <text class="menu-hint">去认证</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <view class="menu-icon-wrap gray">⚙️</view>
      <view class="menu-text-wrap">
        <input class="menu-text-input" value="{{menuNames.settings}}" bindblur="saveMenuName" data-key="settings" />
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMessages">
      <view class="menu-icon-wrap pink">💬</view>
      <view class="menu-text-wrap">
        <input class="menu-text-input" value="{{menuNames.messages}}" bindblur="saveMenuName" data-key="messages" />
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <view class="menu-icon-wrap purple">ℹ️</view>
      <view class="menu-text-wrap">
        <input class="menu-text-input" value="{{menuNames.about}}" bindblur="saveMenuName" data-key="about" />
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <button class="logout-btn" bindtap="onLogout">退出登录</button>
</view>