<!--注册页-->
<view class="register-container">
  <view class="form-section">
    <view class="form-title">注册商家账号</view>
    
    <view class="form-item">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    
    <view class="form-item">
      <view class="form-label">密码</view>
      <input class="form-input" password placeholder="请输入密码（6-20位）" value="{{password}}" bindinput="onPasswordInput" />
    </view>
    
    <view class="form-item">
      <view class="form-label">确认密码</view>
      <input class="form-input" password placeholder="请再次输入密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
    </view>
    
    <button class="btn-register" bindtap="handleRegister" loading="{{loading}}">注册</button>
    
    <view class="login-link" bindtap="goLogin">
      <text>已有账号？</text>
      <text class="link">返回登录</text>
    </view>
  </view>
</view>