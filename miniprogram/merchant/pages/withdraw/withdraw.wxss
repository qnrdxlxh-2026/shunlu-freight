/* 提现页面 */
.withdraw-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.balance-section {
  background: linear-gradient(135deg, #1890ff 0%, #4da6ff 100%);
  padding: 48rpx 32rpx;
  text-align: center;
}

.balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 12rpx;
}

.balance-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
}

.input-section {
  background: #fff;
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 32rpx;
}

.input-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #f0f0f0;
  padding-bottom: 16rpx;
}

.yuan {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  margin-right: 8rpx;
}

.amount-input {
  flex: 1;
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  min-height: auto;
}

.btn-all {
  background: #e6f4ff;
  color: #1890ff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.quick-amounts {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.quick-item {
  flex: 1;
  background: #fff;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #f0f0f0;
}

.fee-section {
  display: flex;
  justify-content: space-between;
  padding: 0 24rpx 24rpx;
  font-size: 24rpx;
  color: #999;
}

.fee-text .actual {
  color: #52c41a;
  font-weight: 600;
}

.notice-section {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.notice-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.bottom-area {
  padding: 32rpx 24rpx;
}

.btn-submit {
  background: #1890ff;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  border-radius: 50rpx;
  border: none;
  width: 100%;
}

.btn-submit.disabled {
  background: #d9d9d9;
  color: #fff;
}
