/* 全局样式 - 顺路货运个人端 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
}

/* 主题色 */
.theme-color { color: #722ed1; }
.bg-theme { background-color: #722ed1; }

/* 状态颜色 */
.status-pending { color: #faad14; }
.status-pickup { color: #1890ff; }
.status-transit { color: #52c41a; }
.status-done { color: #999999; }
.status-cancel { color: #f5222d; }

.bg-pending { background-color: #faad14; }
.bg-pickup { background-color: #1890ff; }
.bg-transit { background-color: #52c41a; }
.bg-done { background-color: #999999; }
.bg-cancel { background-color: #f5222d; }

/* 通用卡片 */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 按钮样式 */
.btn-primary {
  background-color: #722ed1;
  color: #fff;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  width: 100%;
}

.btn-primary::after { border: none; }

.btn-primary:active {
  opacity: 0.85;
}

.btn-outline {
  background-color: transparent;
  color: #722ed1;
  border: 2rpx solid #722ed1;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  width: 100%;
}

.btn-outline::after { border: none; }

/* 输入框 */
.input-wrap {
  display: flex;
  align-items: center;
  background-color: #f7f7f7;
  border-radius: 44rpx;
  padding: 0 30rpx;
  height: 88rpx;
  margin-bottom: 24rpx;
}

.input-wrap input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

/* 标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 20rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  color: #999;
  font-size: 28rpx;
}

/* Flex 工具类 */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.gap-10 { gap: 10rpx; }
.gap-20 { gap: 20rpx; }

/* 安全区域 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
