.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.filter-bar {
  display: flex;
  background-color: #fff;
  padding: 20rpx 30rpx;
  gap: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-item {
  font-size: 28rpx;
  color: #666;
  padding-bottom: 8rpx;
}

.filter-item.active {
  color: #722ed1;
  font-weight: 600;
  border-bottom: 4rpx solid #722ed1;
}

.map-container {
  height: 360rpx;
  background-color: #e8e8e8;
}

.map-container map {
  width: 100%;
  height: 100%;
}

.driver-list {
  flex: 1;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -20rpx;
  padding: 30rpx 24rpx 40rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.list-count {
  font-size: 26rpx;
  color: #999;
}

.driver-item {
  background-color: #f9f9f9;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.driver-info {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.driver-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #e8e8e8;
  flex-shrink: 0;
}

.driver-detail {
  flex: 1;
  margin-left: 20rpx;
}

.driver-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.driver-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.driver-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.badge-truck { background-color: #fff0e6; color: #fa8c16; }
.badge-car { background-color: #e6f4ff; color: #1890ff; }

.driver-route {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.driver-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.driver-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.action-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #722ed1;
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.btn-chat {
  font-size: 26rpx;
  color: #666;
  padding: 12rpx 24rpx;
  background-color: #f0f0f0;
  border-radius: 32rpx;
}

.btn-order {
  font-size: 26rpx;
  color: #fff;
  padding: 12rpx 28rpx;
  background-color: #722ed1;
  border-radius: 32rpx;
}

.empty-list {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
