.messages-page { padding: 24rpx; background: #f5f5f5; min-height: 100vh; }

.conv-list { background: #fff; border-radius: 16rpx; overflow: hidden; }
.conv-item { display: flex; align-items: center; padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0; }
.conv-item:last-child { border-bottom: none; }
.avatar { width: 80rpx; height: 80rpx; background: #722ed1; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; color: #fff;
  font-size: 28rpx; }
.conv-info { flex: 1; margin-left: 20rpx; }
.conv-name { font-size: 28rpx; color: #333; font-weight: 500; }
.conv-last { font-size: 24rpx; color: #999; margin-top: 8rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 400rpx; }
.conv-time { font-size: 22rpx; color: #999; }

.empty { text-align: center; padding: 100rpx 0; color: #999; }
