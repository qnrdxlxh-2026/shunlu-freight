<view class="orders-page">
  <view class="tabs">
    <view class="tab {{tabIndex == index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="index"
      bindtap="changeTab" data-index="{{index}}">{{item}}</view>
  </view>

  <view class="order-list" wx:if="{{!loading}}">
    <view class="order-item" wx:for="{{orders}}" wx:key="id"
      wx:if="{{tabIndex == 0 || (tabIndex == 1 && item.status == 1) || (tabIndex == 2 && item.status == 2) || (tabIndex == 3 && item.status == 3) || (tabIndex == 4 && item.status >= 4)}}"
      bindtap="goDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">订单号: {{item.id}}</text>
        <text class="status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="order-route">
        <text class="from">{{item.start_addr}}</text>
        <text class="arrow">→</text>
        <text class="to">{{item.end_addr}}</text>
      </view>
      <view class="order-footer">
        <text class="time">{{item.create_time}}</text>
        <text class="price">¥{{item.amount}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{orders.length == 0}}">
      <text>暂无订单</text>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
