.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #722ed1 0%, #9b59d0 100%);
  padding: 0 60rpx;
}

.form-section {
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 60rpx 40rpx 0;
  min-height: 100vh;
}

.section-header {
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  background-color: #f7f7f7;
  border-radius: 44rpx;
  padding: 0 36rpx;
  height: 96rpx;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.input-wrap input {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
}

.role-tip {
  display: flex;
  align-items: center;
  background-color: #f0e6ff;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 40rpx;
}

.role-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.role-text {
  font-size: 28rpx;
  color: #722ed1;
  font-weight: 500;
}

.btn-primary {
  background-color: #722ed1;
  color: #fff;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  letter-spacing: 4rpx;
}

.btn-primary::after { border: none; }
.btn-primary:active { opacity: 0.85; }

.form-footer {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  padding-bottom: 60rpx;
}

.link-text {
  color: #722ed1;
  font-size: 28rpx;
}
