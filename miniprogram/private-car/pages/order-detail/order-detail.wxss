/* pages/order-detail/order-detail.wxss */
.detail-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 200rpx;
}

.status-card {
  padding: 40rpx 30rpx;
  text-align: center;
}

.status-card.status-2 { background: linear-gradient(135deg, #fa8c16 0%, #fa541c 100%); }
.status-card.status-3 { background: linear-gradient(135deg, #52c41a 0%, #237804 100%); }
.status-card.status-4 { background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%); }

.status-text {
  display: block;
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.status-tip {
  display: block;
  color: rgba(255,255,255,0.9);
  font-size: 28rpx;
}

.route-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.route-section {
  padding-left: 20rpx;
}

.route-point {
  display: flex;
  align-items: flex-start;
}

.point-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.point-icon.start { background: #fa8c16; }
.point-icon.end { background: #52c41a; }

.point-info {
  flex: 1;
}

.point-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.point-address {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.point-contact {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.route-line {
  width: 4rpx;
  height: 40rpx;
  background: #e8e8e8;
  margin-left: 28rpx;
}

.info-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.info-value.price {
  color: #f5222d;
  font-weight: bold;
}

.info-row.highlight {
  margin-top: 10rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #f0f0f0;
}

.info-row.highlight .info-value {
  font-size: 32rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.08);
}

.btn-primary {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 28rpx 0;
  margin-bottom: 20rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn-outline {
  flex: 1;
  background: #fff;
  color: #1890ff;
  font-size: 28rpx;
  border: 2rpx solid #1890ff;
  border-radius: 50rpx;
  padding: 20rpx 0;
}

.btn-nav {
  background: #52c41a;
  color: #fff;
  font-size: 30rpx;
  border-radius: 50rpx;
  padding: 24rpx 0;
}
