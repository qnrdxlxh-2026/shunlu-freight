/* pages/wallet/wallet.wxss */
.wallet-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.balance-card {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  margin: 30rpx;
  border-radius: 20rpx;
  padding: 40rpx;
  color: #fff;
}

.balance-label {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.balance-amount {
  display: block;
  font-size: 60rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.balance-info {
  display: flex;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}

.balance-info .info-item {
  flex: 1;
  text-align: center;
}

.balance-info .info-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.balance-info .info-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
}

.action-btns {
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.btn-withdraw {
  background: #fff;
  color: #1890ff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 24rpx 0;
  border: 2rpx solid #fff;
}

.section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.transaction-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.transaction-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.transaction-item:last-child {
  border-bottom: none;
}

.trans-info {
  display: flex;
  flex-direction: column;
}

.trans-type {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.trans-time {
  font-size: 24rpx;
  color: #999;
}

.trans-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.trans-amount.income { color: #52c41a; }
.trans-amount.expense { color: #f5222d; }

.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

/* 提现弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
}

.withdraw-info {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
}

.withdraw-info .info-label {
  font-size: 28rpx;
  color: #999;
}

.withdraw-info .info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1890ff;
}

.input-group {
  margin-top: 20rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input-group .input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
}

.btn-confirm {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 0;
  padding: 30rpx 0;
  border: none;
}
