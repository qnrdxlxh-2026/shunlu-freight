<!-- custom-tab-bar/index.wxml -->
<view class="tab-bar" wx:if="{{list.length > 0}}">
  <view class="tab-bar-border"></view>
  <view 
    wx:for="{{list}}" 
    wx:key="pagePath" 
    class="tab-bar-item" 
    data-index="{{index}}" 
    bindtap="switchTab"
  >
    <text class="tab-icon {{selected === index ? 'active' : ''}}">{{item.icon}}</text>
    <text class="tab-text" style="color: {{selected === index ? themeColor : '#999'}}">{{item.text}}</text>
  </view>
</view>
