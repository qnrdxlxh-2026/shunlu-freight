.chat-page{display:flex;flex-direction:column;height:100vh;background:#f5f5f5}
.message-list{flex:1;padding:24rpx}
.message-item{margin-bottom:24rpx}
.message-item.self{text-align:right}
.message-item.other{text-align:left}
.bubble{display:inline-block;max-width:70%;padding:20rpx 24rpx;border-radius:16rpx;font-size:28rpx;word-wrap:break-word}
.message-item.self .bubble{background:#52c41a;color:#fff}
.message-item.other .bubble{background:#fff;color:#333}
.time{font-size:22rpx;color:#999;margin-top:8rpx}
.input-bar{display:flex;align-items:center;padding:16rpx 24rpx;background:#fff;border-top:1rpx solid #eee}
.input{flex:1;background:#f5f5f5;border-radius:40rpx;padding:16rpx 24rpx;font-size:28rpx}
.send-btn{margin-left:16rpx;background:#52c41a;color:#fff;border-radius:40rpx;padding:16rpx 32rpx;font-size:28rpx}
