.find-goods-page { padding: 32rpx; background: #f5f5f5; min-height: 100vh; }

.header { margin-bottom: 32rpx; }
.title { font-size: 40rpx; font-weight: 600; color: #333; }
.tip { font-size: 26rpx; color: #999; margin-left: 16rpx; }

.goods-list { }
.goods-item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); }

.goods-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx; }
.route { flex: 1; font-size: 28rpx; color: #333; }
.from, .to { display: inline-block; max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.arrow { color: #52c41a; margin: 0 16rpx; }
.price { font-size: 36rpx; font-weight: 600; color: #52c41a; }

.goods-info { font-size: 26rpx; color: #666; margin-bottom: 16rpx; }
.dot { margin: 0 8rpx; }

.goods-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f0f0; }
.match-score { display: flex; align-items: center; }
.star { color: #faad14; font-size: 28rpx; }
.match-text { font-size: 24rpx; color: #999; margin-left: 12rpx; }
.take-btn { background: #52c41a; color: #fff; padding: 12rpx 32rpx; border-radius: 40rpx; font-size: 26rpx; }

.empty { text-align: center; padding: 100rpx 0; color: #999; }
.loading { text-align: center; padding: 100rpx 0; color: #999; }
