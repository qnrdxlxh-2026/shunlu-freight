.home-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #e6fff0 0%, #f5f5f5 40%);
  padding-bottom: 40rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 30rpx rgba(82, 196, 26, 0.3);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  border: 4rpx solid rgba(255,255,255,0.5);
  background: #fff;
}

.user-detail {
  margin-left: 24rpx;
}

.user-phone {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.welcome-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

/* 标签 */
.user-tags { margin-top: 8rpx; }
.tag {
  display: inline-block;
  background: rgba(255,255,255,0.25);
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #fff;
}
.tag-truck { background: rgba(255,255,255,0.3); }

/* 运行模式切换 */
.mode-switch-section {
  background: #fff;
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.mode-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.mode-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.mode-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mode-label {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.mode-label.active {
  color: #52c41a;
  font-weight: 600;
}

.mode-desc {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  background: #f8fffa;
  border-radius: 12rpx;
  border-left: 4rpx solid #52c41a;
}

/* 统计区域 */
.stats-section {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.stats-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 8rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.status-orange { color: #fa8c16; }
.status-blue   { color: #1890ff; }
.status-green  { color: #52c41a; }
.primary       { color: #52c41a; }

/* 快捷入口 */
.quick-entry {
  margin: 0 24rpx 24rpx;
}

.quick-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.quick-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  position: relative;
  overflow: hidden;
}

.quick-item::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 6rpx;
}

.quick-item:nth-child(1)::before { background: linear-gradient(90deg, #52c41a, #73d13d); }
.quick-item:nth-child(2)::before { background: linear-gradient(90deg, #1890ff, #69b1ff); }
.quick-item:nth-child(3)::before { background: linear-gradient(90deg, #fa8c16, #ffc53d); }
.quick-item:nth-child(4)::before { background: linear-gradient(90deg, #722ed1, #9254de); }

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 16rpx;
}

.bg-green  { background: #f6ffed; }
.bg-blue   { background: #e6f4ff; }
.bg-orange { background: #fff7e6; }
.bg-purple { background: #f9f0ff; }

.quick-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.quick-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
}

/* 最新订单 */
.orders-section {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #52c41a;
}

.order-list { margin-bottom: 16rpx; }

.order-item {
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.badge {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.order-route {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.route-point {
  display: flex;
  align-items: center;
  flex: 1;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.dot.green { background: #52c41a; }
.dot.red   { background: #ff4d4f; }

.route-arrow {
  margin: 0 16rpx;
  color: #999;
}

.order-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #f0f0f0;
}

.order-time {
  font-size: 22rpx;
  color: #999;
}

.order-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #999;
}
