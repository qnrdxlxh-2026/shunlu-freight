/* 司机端个人中心 */
.profile-page { min-height: 100vh; background: #f5f5f5; }

.user-card {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  padding: 40rpx 32rpx 36rpx;
  display: flex; align-items: center;
}
.avatar-btn {
  background: none; border: none; padding: 0; margin: 0;
  line-height: 1; position: relative; flex-shrink: 0;
}
.avatar-btn::after { border: none; }
.avatar {
  width: 130rpx; height: 130rpx; border-radius: 65rpx;
  border: 6rpx solid rgba(255,255,255,0.6);
  display: block; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}
.avatar-edit-badge {
  position: absolute; bottom: 0; right: 0;
  width: 44rpx; height: 44rpx; background: #fff; border-radius: 22rpx;
  font-size: 22rpx; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}
.user-detail { margin-left: 28rpx; flex: 1; }
.user-name-row { display: flex; align-items: center; margin-bottom: 6rpx; }
.name-edit-input {
  font-size: 36rpx; font-weight: 600; color: #fff;
  background: transparent; border: none; outline: none;
  flex: 1; padding: 0;
}
.name-edit-input:disabled { color: #fff; opacity: 1; }
.edit-icon {
  font-size: 28rpx; margin-left: 12rpx; opacity: 0.8;
  background: rgba(255,255,255,0.25); border-radius: 8rpx;
  padding: 4rpx 10rpx; color: #fff;
}
.edit-icon.sm { font-size: 22rpx; margin-left: 8rpx; padding: 4rpx 8rpx; }
.user-sub { font-size: 24rpx; color: rgba(255,255,255,0.82); }

.stats-row {
  display: flex; align-items: center;
  background: #fff; margin: -16rpx 24rpx 24rpx;
  border-radius: 16rpx; padding: 28rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  position: relative; z-index: 1;
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 36rpx; font-weight: 700; color: #52c41a; }
.stat-num-input {
  font-size: 36rpx; font-weight: 700; color: #52c41a;
  background: transparent; border: none; text-align: center; width: 100%; padding: 0;
}
.stat-num-input:disabled { color: #52c41a; opacity: 1; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.stat-div { width: 1rpx; height: 60rpx; background: #f0f0f0; }

.menu-section {
  margin: 0 24rpx 24rpx;
  background: #fff; border-radius: 16rpx;
  overflow: hidden; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.menu-title-row {
  display: flex; align-items: center;
  padding: 20rpx 28rpx 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-title-label { font-size: 24rpx; color: #666; font-weight: 600; flex: 1; }

.menu-item {
  display: flex; align-items: center;
  padding: 24rpx 28rpx; border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child { border-bottom: none; }

.menu-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; margin-right: 20rpx; flex-shrink: 0;
}
.menu-icon-wrap.blue    { background: #e6f4ff; }
.menu-icon-wrap.teal    { background: #e6fffb; }
.menu-icon-wrap.green   { background: #f6ffed; }
.menu-icon-wrap.gold    { background: #fffbe6; }
.menu-icon-wrap.pink    { background: #fff0f6; }
.menu-icon-wrap.gray    { background: #f5f5f5; }
.menu-icon-wrap.purple  { background: #f9f0ff; }

.menu-text-wrap { flex: 1; }
.menu-text-input {
  font-size: 28rpx; color: #333;
  background: transparent; border: none; outline: none;
  width: 100%; padding: 0;
}
.menu-text-input:focus {
  background: #f6ffed; border-radius: 8rpx;
  padding: 6rpx 12rpx; margin: -6rpx -12rpx;
}
.menu-hint { font-size: 22rpx; color: #999; margin-right: 8rpx; }
.arrow    { color: #ccc; font-size: 32rpx; }

.logout-btn {
  display: block; margin: 16rpx 24rpx 40rpx;
  background: #fff; border: none; border-radius: 50rpx;
  padding: 28rpx; font-size: 30rpx; color: #f5222d; text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.logout-btn::after { border: none; }

/* 证件信息卡片 */
.cert-card {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; margin: 0 24rpx 24rpx;
  border-radius: 16rpx; padding: 28rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.cert-left { display: flex; align-items: center; flex: 1; }
.cert-icon { font-size: 48rpx; margin-right: 20rpx; }
.cert-info { display: flex; flex-direction: column; }
.cert-title { font-size: 28rpx; color: #333; font-weight: 600; }
.cert-status { font-size: 22rpx; margin-top: 6rpx; color: #52c41a; }
.cert-status.pending { color: #faad14; }

/* 弹窗样式 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 999;
}
.modal-content {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  z-index: 1000; padding-bottom: env(safe-area-inset-bottom);
}
.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; border-bottom: 1rpx solid #f0f0f0;
}
.modal-title { font-size: 32rpx; font-weight: 600; color: #333; }
.modal-close { font-size: 36rpx; color: #999; padding: 8rpx; }
.modal-body { padding: 28rpx 32rpx; max-height: 60vh; overflow-y: auto; }
.modal-footer {
  display: flex; padding: 20rpx 32rpx 28rpx; gap: 20rpx;
}
.modal-btn { flex: 1; border-radius: 50rpx; font-size: 30rpx; padding: 24rpx 0; }
.modal-btn.cancel { background: #f5f5f5; color: #666; border: none; }
.modal-btn.confirm { background: #52c41a; color: #fff; border: none; }
.modal-btn::after { border: none; }

.form-group { margin-bottom: 28rpx; }
.form-label { font-size: 26rpx; color: #666; margin-bottom: 12rpx; display: block; }
.form-control {
  border: 1rpx solid #e8e8e8; border-radius: 12rpx;
  padding: 20rpx 24rpx; font-size: 28rpx; width: 100%;
  box-sizing: border-box;
}

/* 照片网格 */
.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo-item {
  width: 180rpx; height: 180rpx; position: relative;
  border-radius: 12rpx; overflow: hidden;
}
.photo-thumb { width: 100%; height: 100%; }
.photo-del {
  position: absolute; top: 0; right: 0;
  width: 44rpx; height: 44rpx;
  background: rgba(0,0,0,0.5); color: #fff;
  font-size: 28rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 0 0 0 12rpx;
}
.photo-add {
  width: 180rpx; height: 180rpx;
  border: 2rpx dashed #d9d9d9; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
}
.photo-add-icon { font-size: 56rpx; color: #bbb; }

/* 审核状态颜色 */
.cert-status.approved { color: #52c41a; }
.cert-status.rejected { color: #f5222d; }

/* 证件区域标题 */
.cert-section-title {
  font-size: 28rpx; font-weight: 600; color: #333;
  margin: 24rpx 0 16rpx; padding-left: 4rpx;
}
.cert-section-title:first-child { margin-top: 0; }

/* 2列照片上传卡片 */
.photo-grid-2col {
  display: flex; gap: 16rpx; margin-bottom: 8rpx;
}
.photo-upload-card { flex: 1; position: relative; }
.photo-preview {
  width: 100%; height: 200rpx; border-radius: 12rpx; display: block;
}
.photo-placeholder {
  width: 100%; height: 200rpx;
  border: 2rpx dashed #d9d9d9; border-radius: 12rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: #fafafa;
}
.photo-plus { font-size: 56rpx; color: #bbb; line-height: 1; }
.photo-card-label {
  display: block; text-align: center;
  font-size: 22rpx; color: #666; margin-top: 8rpx;
}
.photo-del-btn {
  position: absolute; top: -8rpx; right: -8rpx;
  width: 40rpx; height: 40rpx;
  background: #f5222d; color: #fff; border-radius: 50%;
  font-size: 28rpx; display: flex; align-items: center; justify-content: center;
  z-index: 2; line-height: 40rpx; text-align: center;
}
.menu-text-val { font-size: 28rpx; color: #333; }
