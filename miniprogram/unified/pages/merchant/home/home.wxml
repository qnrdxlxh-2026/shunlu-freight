<view class="home-page">
  <!-- 顶部用户卡片 -->
  <view class="user-card">
    <view class="user-left">
      <image class="avatar" src="{{userInfo.avatar || '/assets/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="user-info">
        <text class="phone">{{userInfo.phone || '未登录'}}</text>
        <view class="role-badge">
          <text class="role-text">商家</text>
        </view>
      </view>
    </view>
    <view class="balance-box">
      <text class="balance-label">账户余额</text>
      <text class="balance-num">¥{{wallet.balance || 0}}</text>
    </view>
  </view>

  <!-- 统计区域 -->
  <view class="stats-card">
    <view class="stat-item" bindtap="goOrders" data-status="pending">
      <view class="stat-icon blue">
        <text>📦</text>
      </view>
      <text class="stat-num">{{stats.pending || 0}}</text>
      <text class="stat-label">待取货</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goOrders" data-status="inProgress">
      <view class="stat-icon orange">
        <text>🚚</text>
      </view>
      <text class="stat-num">{{stats.inProgress || 0}}</text>
      <text class="stat-label">配送中</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goOrders" data-status="completed">
      <view class="stat-icon green">
        <text>✅</text>
      </view>
      <text class="stat-num">{{stats.completed || 0}}</text>
      <text class="stat-label">已完成</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-title">快捷功能</view>
    <view class="menu-grid">
      <view class="menu-card blue" bindtap="goPublish">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/assets/publish.png" mode="aspectFit"></image>
        </view>
        <text class="menu-name">发布货源</text>
        <text class="menu-desc">发布新货运需求</text>
      </view>
      <view class="menu-card green" bindtap="goMyGoods">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/assets/goods.png" mode="aspectFit"></image>
        </view>
        <text class="menu-name">我的货源</text>
        <text class="menu-desc">管理已发布的货源</text>
      </view>
      <view class="menu-card orange" bindtap="goOrders">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/assets/all-orders.png" mode="aspectFit"></image>
        </view>
        <text class="menu-name">全部订单</text>
        <text class="menu-desc">查看所有订单</text>
      </view>
      <view class="menu-card red" bindtap="goWallet">
        <view class="menu-icon-wrap">
          <image class="menu-icon" src="/assets/wallet.png" mode="aspectFit"></image>
        </view>
        <text class="menu-name">我的钱包</text>
        <text class="menu-desc">查看账户明细</text>
      </view>
    </view>
  </view>

  <!-- 最近订单入口 -->
  <view class="recent-section">
    <view class="recent-header">
      <text class="recent-title">最近订单</text>
      <view class="more-btn" bindtap="goOrders">
        <text>查看全部</text>
        <image class="arrow-icon" src="/assets/arrow-right.png" mode="aspectFit"></image>
      </view>
    </view>
  </view>
</view>
