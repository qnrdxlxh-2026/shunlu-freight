.detail-page{padding:24rpx;background:#f5f5f5;min-height:100vh}
.status-bar{padding:32rpx;border-radius:16rpx;margin-bottom:24rpx;text-align:center}
.status-bar.orange{background:linear-gradient(135deg,#fa8c16,#d46b08)}
.status-bar.green{background:linear-gradient(135deg,#52c41a,#389e0d)}
.status-bar.blue{background:linear-gradient(135deg,#1890ff,#096dd9)}
.status-text{color:#fff;font-size:36rpx;font-weight:600}
.route-section{background:#fff;border-radius:16rpx;padding:32rpx;margin-bottom:24rpx}
.route-item{display:flex;align-items:flex-start}
.dot{width:24rpx;height:24rpx;border-radius:50%;margin-right:16rpx;margin-top:6rpx}
.dot.green{background:#52c41a}
.dot.red{background:#f5222d}
.addr{flex:1;font-size:28rpx;color:#333}
.route-line{width:4rpx;height:40rpx;background:#e8e8e8;margin-left:10rpx}
.info-section{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:24rpx}
.info-item{display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #f0f0f0}
.info-item:last-child{border-bottom:none}
.label{font-size:28rpx;color:#666}
.value{font-size:28rpx;color:#333}
.value.price{color:#f5222d;font-weight:600}
.action-section{margin-top:32rpx}
.pay-btn{background:#1890ff;color:#fff;border-radius:50rpx;padding:28rpx 0;font-size:32rpx;text-align:center}
.call-btn{background:#52c41a;color:#fff;border-radius:50rpx;padding:28rpx 0;font-size:32rpx;text-align:center}

/* 中途装卸点二维码样式 */
.qr-waypoints {
  margin-top: 24rpx;
}
.waypoint-qr-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.waypoint-qr-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.waypoint-qr-index {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.waypoint-qr-type {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
}
.waypoint-qr-info {
  margin-bottom: 16rpx;
}
.waypoint-qr-code-box {
  display: flex;
  justify-content: center;
  align-items: center;
  background: #f0f0f0;
  padding: 16rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
.waypoint-qr-code-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 12rpx;
}
.waypoint-qr-code {
  font-size: 40rpx;
  font-weight: 600;
  color: #f5222d;
}
.waypoint-qr-img-box {
  display: flex;
  justify-content: center;
}
.waypoint-qr-img {
  width: 200rpx;
  height: 200rpx;
}
