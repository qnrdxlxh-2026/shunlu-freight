<view class="wallet-page">
  <!-- 余额卡片 -->
  <view class="balance-card">
    <view class="balance-label">账户余额(元)</view>
    <view class="balance-amount">¥{{wallet ? wallet.balance : '0.00'}}</view>
    <view class="balance-actions">
      <view class="action-btn recharge" bindtap="showRechargeModal">充值</view>
      <view class="action-btn withdraw" bindtap="showWithdrawModal">提现</view>
    </view>
  </view>

  <!-- 统计栏 -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num">{{wallet.frozen_amount || 0}}</text>
      <text class="stat-label">冻结金额</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{wallet.withdrawable || wallet.balance || 0}}</text>
      <text class="stat-label">可提现</text>
    </view>
  </view>

  <!-- 交易记录 -->
  <view class="records-section">
    <view class="section-title">交易记录</view>
    <view class="record-list">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="record-left">
          <view class="record-type">{{item.remark || item.type || '交易'}}</view>
          <view class="record-time">{{item.create_time || item.time || ''}}</view>
        </view>
        <view class="record-amount {{item.amount > 0 ? 'income' : 'expense'}}">
          {{item.amount > 0 ? '+' : ''}}¥{{item.amount}}
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{records.length == 0}}">
      <text>暂无交易记录</text>
    </view>
  </view>

  <!-- 充值弹窗 -->
  <view class="modal" wx:if="{{showRecharge}}" bindtap="hideRechargeModal">
    <view class="modal-content" catchtap>
      <view class="modal-title">充值</view>
      <input class="modal-input" type="digit" placeholder="请输入充值金额"
        value="{{rechargeAmount}}" bindinput="onRechargeInput"/>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="hideRechargeModal">取消</view>
        <view class="modal-btn confirm" bindtap="doRecharge">确认</view>
      </view>
    </view>
  </view>

  <!-- 提现弹窗 -->
  <view class="modal" wx:if="{{showWithdraw}}" bindtap="hideWithdrawModal">
    <view class="modal-content" catchtap>
      <view class="modal-title">提现</view>
      <view class="withdraw-info">可提现金额：¥{{wallet.withdrawable || wallet.balance || 0}}</view>
      <input class="modal-input" type="digit" placeholder="最低提现10元"
        value="{{withdrawAmount}}" bindinput="onWithdrawInput"/>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="hideWithdrawModal">取消</view>
        <view class="modal-btn confirm" bindtap="doWithdraw">确认</view>
      </view>
    </view>
  </view>
</view>
