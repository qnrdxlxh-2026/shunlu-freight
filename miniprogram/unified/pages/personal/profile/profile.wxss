/* 个人端个人中心 */
.profile-page { min-height: 100vh; background: #f5f5f5; }

.user-card {
  background: linear-gradient(135deg, #722ed1 0%, #9254de 100%);
  padding: 40rpx 32rpx 36rpx;
  display: flex; align-items: center;
}
.avatar-btn {
  background: none; border: none; padding: 0; margin: 0;
  line-height: 1; position: relative; flex-shrink: 0;
}
.avatar-btn::after { border: none; }
.avatar {
  width: 130rpx; height: 130rpx; border-radius: 65rpx;
  border: 6rpx solid rgba(255,255,255,0.6);
  display: block; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}
.avatar-edit-badge {
  position: absolute; bottom: 0; right: 0;
  width: 44rpx; height: 44rpx; background: #fff; border-radius: 22rpx;
  font-size: 22rpx; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}
.user-detail { margin-left: 28rpx; flex: 1; }
.user-name-row { display: flex; align-items: center; margin-bottom: 6rpx; }
.name-edit-input {
  font-size: 36rpx; font-weight: 600; color: #fff;
  background: transparent; border: none; outline: none;
  flex: 1; padding: 0;
}
.name-edit-input:disabled { color: #fff; opacity: 1; }
.edit-icon {
  font-size: 28rpx; margin-left: 12rpx; opacity: 0.8;
  background: rgba(255,255,255,0.25); border-radius: 8rpx;
  padding: 4rpx 10rpx; color: #fff;
}
.edit-icon.sm { font-size: 22rpx; margin-left: 8rpx; padding: 4rpx 8rpx; }
.user-sub { font-size: 24rpx; color: rgba(255,255,255,0.82); }

.stats-row {
  display: flex; align-items: center;
  background: #fff; margin: -16rpx 24rpx 24rpx;
  border-radius: 16rpx; padding: 28rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  position: relative; z-index: 1;
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 36rpx; font-weight: 700; color: #722ed1; }
.stat-num-input {
  font-size: 36rpx; font-weight: 700; color: #722ed1;
  background: transparent; border: none; text-align: center; width: 100%; padding: 0;
}
.stat-num-input:disabled { color: #722ed1; opacity: 1; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.stat-div { width: 1rpx; height: 60rpx; background: #f0f0f0; }

.menu-section {
  margin: 0 24rpx 24rpx;
  background: #fff; border-radius: 16rpx;
  overflow: hidden; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.menu-title-row {
  display: flex; align-items: center;
  padding: 20rpx 28rpx 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-title-label { font-size: 24rpx; color: #666; font-weight: 600; flex: 1; }

.menu-item {
  display: flex; align-items: center;
  padding: 24rpx 28rpx; border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child { border-bottom: none; }

.menu-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; margin-right: 20rpx; flex-shrink: 0;
}
.menu-icon-wrap.purple { background: #f9f0ff; }
.menu-icon-wrap.blue   { background: #e6f4ff; }
.menu-icon-wrap.gold   { background: #fffbe6; }
.menu-icon-wrap.pink   { background: #fff0f6; }
.menu-icon-wrap.gray  { background: #f5f5f5; }

.menu-text-wrap { flex: 1; }
.menu-text-input {
  font-size: 28rpx; color: #333;
  background: transparent; border: none; outline: none;
  width: 100%; padding: 0;
}
.menu-text-input:focus {
  background: #f9f0ff; border-radius: 8rpx;
  padding: 6rpx 12rpx; margin: -6rpx -12rpx;
}
.menu-hint { font-size: 22rpx; color: #999; margin-right: 8rpx; }
.arrow    { color: #ccc; font-size: 32rpx; }

.logout-btn {
  display: block; margin: 16rpx 24rpx 40rpx;
  background: #fff; border: none; border-radius: 50rpx;
  padding: 28rpx; font-size: 30rpx; color: #f5222d; text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.logout-btn::after { border: none; }