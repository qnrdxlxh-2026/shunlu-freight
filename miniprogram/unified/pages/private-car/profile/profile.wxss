/* pages/profile/profile.wxss */
.profile-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.user-card {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  margin-right: 30rpx;
}

.user-info {
  flex: 1;
}

.name {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.phone {
  display: block;
  color: rgba(255,255,255,0.8);
  font-size: 28rpx;
  margin-bottom: 6rpx;
}

.car-info {
  display: block;
  color: rgba(255,255,255,0.9);
  font-size: 26rpx;
}

.limit-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.limit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.limit-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.limit-tip {
  font-size: 24rpx;
  color: #999;
}

.limit-progress {
  display: flex;
  align-items: center;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1890ff 0%, #52c41a 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: bold;
}

.menu-list {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.rules-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.rules-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.rules-item {
  font-size: 26rpx;
  color: #666;
  line-height: 48rpx;
}

.btn-logout {
  background: #fff;
  color: #f5222d;
  font-size: 32rpx;
  border-radius: 50rpx;
  margin: 40rpx 20rpx;
  padding: 24rpx 0;
}

/* 证件信息卡片 */
.cert-card {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; margin: 20rpx;
  border-radius: 16rpx; padding: 28rpx 28rpx;
}
.cert-left { display: flex; align-items: center; flex: 1; }
.cert-icon { font-size: 48rpx; margin-right: 20rpx; }
.cert-info { display: flex; flex-direction: column; }
.cert-title { font-size: 28rpx; color: #333; font-weight: 600; }
.cert-status { font-size: 22rpx; margin-top: 6rpx; color: #52c41a; }
.cert-status.pending { color: #faad14; }
.cert-status.approved { color: #52c41a; }
.cert-status.rejected { color: #f5222d; }
.cert-arrow { color: #ccc; font-size: 32rpx; }

/* 弹窗样式 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 999;
}
.modal-content {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  z-index: 1000; padding-bottom: env(safe-area-inset-bottom);
}
.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; border-bottom: 1rpx solid #f0f0f0;
}
.modal-title { font-size: 32rpx; font-weight: 600; color: #333; }
.modal-close { font-size: 36rpx; color: #999; padding: 8rpx; }
.modal-body { padding: 28rpx 32rpx; max-height: 60vh; overflow-y: auto; }
.modal-footer {
  display: flex; padding: 20rpx 32rpx 28rpx; gap: 20rpx;
}
.modal-btn { flex: 1; border-radius: 50rpx; font-size: 30rpx; padding: 24rpx 0; }
.modal-btn.cancel { background: #f5f5f5; color: #666; border: none; }
.modal-btn.confirm { background: #1890ff; color: #fff; border: none; }
.modal-btn::after { border: none; }

.form-group { margin-bottom: 28rpx; }
.form-label { font-size: 26rpx; color: #666; margin-bottom: 12rpx; display: block; }
.form-control {
  border: 1rpx solid #e8e8e8; border-radius: 12rpx;
  padding: 20rpx 24rpx; font-size: 28rpx; width: 100%;
  box-sizing: border-box;
}

/* 照片网格 */
.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo-item {
  width: 180rpx; height: 180rpx; position: relative;
  border-radius: 12rpx; overflow: hidden;
}
.photo-thumb { width: 100%; height: 100%; }
.photo-del {
  position: absolute; top: 0; right: 0;
  width: 44rpx; height: 44rpx;
  background: rgba(0,0,0,0.5); color: #fff;
  font-size: 28rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 0 0 0 12rpx;
}
.photo-add {
  width: 180rpx; height: 180rpx;
  border: 2rpx dashed #d9d9d9; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
}
.photo-add-icon { font-size: 56rpx; color: #bbb; }

/* 证件区域标题 */
.cert-section-title {
  font-size: 28rpx; font-weight: 600; color: #333;
  margin: 24rpx 0 16rpx; padding-left: 4rpx;
}
.cert-section-title:first-child { margin-top: 0; }

/* 2列照片上传卡片 */
.photo-grid-2col {
  display: flex; gap: 16rpx; margin-bottom: 8rpx;
}
.photo-upload-card { flex: 1; position: relative; }
.photo-preview {
  width: 100%; height: 200rpx; border-radius: 12rpx; display: block;
}
.photo-placeholder {
  width: 100%; height: 200rpx;
  border: 2rpx dashed #d9d9d9; border-radius: 12rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: #fafafa;
}
.photo-plus { font-size: 56rpx; color: #bbb; line-height: 1; }
.photo-card-label {
  display: block; text-align: center;
  font-size: 22rpx; color: #666; margin-top: 8rpx;
}
.photo-del-btn {
  position: absolute; top: -8rpx; right: -8rpx;
  width: 40rpx; height: 40rpx;
  background: #f5222d; color: #fff; border-radius: 50%;
  font-size: 28rpx; display: flex; align-items: center; justify-content: center;
  z-index: 2; line-height: 40rpx; text-align: center;
}
