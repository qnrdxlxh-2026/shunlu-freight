.scan-page {
  padding: 32rpx;
  min-height: 100vh;
  background: #f5f5f5;
}
.scan-header {
  text-align: center;
  padding: 80rpx 0;
}
.scan-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.scan-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.scan-desc {
  font-size: 28rpx;
  color: #999;
}
.scan-btn {
  background: #1890ff;
  color: #fff;
  font-size: 36rpx;
  padding: 28rpx 0;
  border-radius: 50rpx;
  margin: 40rpx 32rpx;
}
.manual-input {
  margin-top: 60rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
}
.manual-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
  text-align: center;
}
.manual-input-field {
  font-size: 36rpx;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.manual-btn {
  background: #52c41a;
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx 0;
  border-radius: 8rpx;
}
