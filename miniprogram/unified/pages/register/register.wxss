/* pages/register/register.wxss */
.register-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 40rpx;
}

.reg-header {
  padding-top: 100rpx;
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.role-tag {
  display: inline-block;
  background: rgba(24,144,255,0.1);
  color: #1890ff;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.reg-form { margin-bottom: 40rpx; }

.form-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.form-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.form-input {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
}

.reg-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #1890ff;
  color: #fff;
  font-size: 34rpx;
  border-radius: 12rpx;
  border: none;
  margin-bottom: 30rpx;
}

.reg-btn::after { border: none; }
.reg-btn[disabled] { opacity: 0.6; }

.reg-footer { text-align: center; }

.link {
  font-size: 26rpx;
  color: #1890ff;
}

/* 照片上传 */
.photo-item {
  align-items: flex-start;
  height: auto;
  padding: 20rpx 24rpx;
}

.photo-section { flex: 1; }

.photo-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.photo-upload-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-add-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.photo-add-icon {
  font-size: 56rpx;
  color: #999;
  line-height: 1;
}

.photo-add-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.photo-preview {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.photo-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.photo-del {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 28rpx;
}

/* 温馨提示 */
.reg-tip {
  background: #fffbe6;
  border: 2rpx solid #ffe58f;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 32rpx;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  color: #ad6800;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: #874d00;
  line-height: 1.6;
}

/* 角色主题色 */
.role-merchant .reg-btn { background: #722ed1; }
.role-merchant .role-tag { background: rgba(114,46,209,0.1); color: #722ed1; }

.role-driver .reg-btn { background: #52c41a; }
.role-driver .role-tag { background: rgba(82,196,26,0.1); color: #52c41a; }

.role-private-car .reg-btn { background: #1890ff; }
.role-private-car .role-tag { background: rgba(24,144,255,0.1); color: #1890ff; }

.role-personal .reg-btn { background: #fa8c16; }
.role-personal .role-tag { background: rgba(250,140,22,0.1); color: #fa8c16; }

/* 微信快速注册标识 */
.wx-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(7,193,96,0.1);
  border: 1rpx solid rgba(7,193,96,0.3);
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
  margin-top: 12rpx;
}
.wx-badge-icon {
  font-size: 22rpx;
  color: #07c160;
  font-weight: bold;
  margin-right: 6rpx;
}
.wx-badge-text {
  font-size: 22rpx;
  color: #07c160;
}
