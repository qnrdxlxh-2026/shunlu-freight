/* pages/role-select/role-select.wxss */
.role-select-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #1890ff 0%, #722ed1 100%);
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  padding-top: 160rpx;
  margin-bottom: 80rpx;
  text-align: center;
}

.logo-text {
  display: block;
  font-size: 64rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.role-cards {
  width: 100%;
}

.role-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.role-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.role-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.merchant .role-icon { background: rgba(24,144,255,0.1); }
.driver .role-icon { background: rgba(82,196,26,0.1); }
.private-car .role-icon { background: rgba(24,144,255,0.1); }
.personal .role-icon { background: rgba(114,46,209,0.1); }

.role-info {
  flex: 1;
}

.role-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.role-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.role-arrow {
  font-size: 48rpx;
  color: #ccc;
  margin-left: 10rpx;
}

.login-tip {
  margin-top: 60rpx;
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  display: block;
  margin-bottom: 16rpx;
}

.switch-btn {
  font-size: 26rpx;
  color: #fff;
  text-decoration: underline;
}
